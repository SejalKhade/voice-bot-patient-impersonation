# Copy to .env and fill in. Never commit .env.

# --- Twilio: places the outbound calls -------------------------------------
# console.twilio.com -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# A voice-capable number you own, E.164. This is the single number all test
# calls originate from, and the one you report on the submission form.
TWILIO_FROM_NUMBER=+15551234567

# --- Anthropic: caller brain, analyst and adjudicator ----------------------
ANTHROPIC_API_KEY=sk-ant-

# --- Deepgram: live speech to text -----------------------------------------
DEEPGRAM_API_KEY=

# --- Voice provider: which TTS engine speaks for the caller ----------------
# elevenlabs | openai. ElevenLabs needs a paid plan to use library voices via
# the API; OpenAI TTS is pay-per-use with no subscription. Leave as elevenlabs
# unless ELEVENLABS_API_KEY isn't on a paid plan.
VOICE_PROVIDER=elevenlabs

# --- ElevenLabs: caller voice ----------------------------------------------
# Emits ulaw_8000 directly, which is Twilio's native format.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- OpenAI: caller voice if VOICE_PROVIDER=openai --------------------------
OPENAI_API_KEY=

# --- Public tunnel ----------------------------------------------------------
# ngrok host with no scheme and no trailing slash.
PUBLIC_BASE_URL=a1b2c3d4.ngrok-free.app

# --- Line under test --------------------------------------------------------
TARGET_NUMBER=+18054398008
